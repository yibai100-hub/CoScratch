  <!--
    This transform is not a visual adjustment.  It is the existing validated
    link6-to-four-hole-mount transform expressed in the new link5 coordinates.
    The coordinate change was solved by rigidly registering the new link5.STL
    and prior link6.STL (same terminal CAD component).  The registration is
    frozen here for first RViz validation only; no arm joint is changed.
  -->
  <link name="Hand_Mount_Frame"/>
  <joint name="link5_to_hand_mount_fixed" type="fixed">
    <parent link="link5"/>
    <child link="Hand_Mount_Frame"/>
    <origin rpy="-0.713347563030 0.579440289127 -1.006647326593" xyz="0.029686590651 -0.000100797035 0.024120115595"/>
  </joint>
  <!-- Official hand-root clocking on its physical four-hole mounting plane. -->
  <joint name="hand_mount_to_aero_right_base_fixed" type="fixed">
    <parent link="Hand_Mount_Frame"/>
    <child link="right_base_link"/>
    <origin rpy="0 0 -0.785398163397448" xyz="0 0 0"/>
  </joint>
</robot>

